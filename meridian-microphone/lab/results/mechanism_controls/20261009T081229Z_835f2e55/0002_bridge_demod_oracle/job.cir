.options reltol=1e-6 method=gear maxord=2 abstol=1e-15 vntol=1e-9 gmin=1e-15
.include "/home/leobareth/Dokumente/Hardware/audio-works/meridian-microphone/lab/results/mechanism_controls/20261009T081229Z_835f2e55/source/models/capsule/flat_k47.cir"
.include "/home/leobareth/Dokumente/Hardware/audio-works/meridian-microphone/lab/results/mechanism_controls/20261009T081229Z_835f2e55/source/models/environment/p48.cir"
VP pressure 0 DC 0 AC {PRESSURE_AC} SIN(0 {PRESSURE_PEAK} {FREQ})
VPR pressure_r 0 DC 0 AC 0
Xenv p n mic_g pp pn cm P48 VS={VS} FT={FT} FM={FM} LEN={LEN} RW={RW} RS={RS} CD={CD} CS={CS} ZIN={ZIN} ZM={ZM} CC={CC} CP={CP} START={START} CMAC={CMAC}

Vrf bb 0 DC 40 SIN(40 0 100k)
Vanti aa 0 DC 40 SIN(40 0 100k)
Vpressure pf 0 SIN(0 1 1k)
Vrearpressure pr 0 0
Xisland ff bb rr pf pr 0 FLAT_K47 CF=70p CR=70p PAR=1f CROSS=1f LEAK=1e14
Ccomparef ff aa 100p
Ccomparer rr aa 100p
Rreturnf ff 0 1e12
Rreturnr rr 0 1e12
Bproduct dd 0 V=2*(v(ff)-v(rr))*sin(2*pi*100k*time)
Rlp dd recovered 1k
Clp recovered 0 100n
.control
set filetype=ascii
set numdgt=16
tran 3.125e-07 .03 .02 3.125e-07
write control.raw time v(ff) v(rr) v(dd) v(recovered)
quit
.endc
.end
