#!/usr/bin/env bash
set -euo pipefail
LAB_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export LD_LIBRARY_PATH="$LAB_DIR/tools/ngspice/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
mkdir -p "$LAB_DIR/tools/config"
{
  printf 'set num_threads=1\n'
  for model in "$LAB_DIR"/tools/ngspice/usr/lib/ngspice/*.cm; do
    printf 'codemodel %s\n' "$model"
  done
} > "$LAB_DIR/tools/config/spinit"
export SPICE_SCRIPTS="$LAB_DIR/tools/config"
exec "$LAB_DIR/tools/ngspice/usr/bin/ngspice" "$@"
