# Local agent configuration and operating-system files.
.agents/
.aws/
.codex/
.DS_Store
Thumbs.db

# Local credentials must never be committed.
.env
.env.*
!.env.example

# Downloaded runtime packages; bootstrap instructions and checksums are retained.
/meridian-microphone/lab/.tools/

# Temporary synchronization and pytest aliases, not experiment evidence.
/meridian-microphone/lab/results/archive.lock
/meridian-microphone/lab/results/verification/**/raw_tests/*current

# Private preservation attestations and root tooling caches.
.project-local/
/tests/**/__pycache__/
/tools/__pycache__/
